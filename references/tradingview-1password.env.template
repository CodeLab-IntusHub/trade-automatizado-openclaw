# Template de referências 1Password para login TradingView.
# Copie para um arquivo fora do Git, por exemplo:
# ~/.openclaw/state/trade-automatizado-openclaw/tradingview-1password.env
#
# Ajuste Vault/Item/campos conforme o item criado no 1Password.
# Não coloque senha literal aqui. Use referências op://.

TRADINGVIEW_USERNAME=op://Private/TradingView/username
TRADINGVIEW_PASSWORD=op://Private/TradingView/password

//@version=5
indicator("IntusCripto HYBRID 15m", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=500)

emaFastLen = input.int(9, "EMA fast", minval=1)
emaMidLen = input.int(21, "EMA mid", minval=1)
rsiLen = input.int(14, "RSI length", minval=1)
stochLen = input.int(14, "Stoch length", minval=1)
volumeAvgLen = input.int(20, "Volume SMA length", minval=1)
atrLen = input.int(14, "ATR length", minval=1)
profile = input.string("moderate", "Risk profile", options=["conservative", "moderate", "degen"])
enforceTimeframe = input.bool(true, "Enforce 15m timeframe")

timeframeOk = not enforceTimeframe or timeframe.period == "15"
ema9 = ta.ema(close, emaFastLen)
ema21 = ta.ema(close, emaMidLen)
rsi14 = ta.rsi(close, rsiLen)
stochK = ta.stoch(close, high, low, stochLen)
[macd, macdSignal, _] = ta.macd(close, 12, 26, 9)
volumeSma = ta.sma(volume, volumeAvgLen)
atr14 = ta.atr(atrLen)

compressionHigh = ta.highest(high[5], 8)
compressionLow = ta.lowest(low[5], 8)
compressionAtr = ta.sma(atr14[5], 8)
atrRef = math.max(math.max(compressionAtr, atr14), syminfo.mintick)
compressionRange = compressionHigh - compressionLow
isLateral = compressionRange <= atrRef * 4.0
impulseHigh = ta.highest(high[1], 4)
impulseLow = ta.lowest(low[1], 4)
pullbackBand = atrRef * 0.35

longHadImpulse = impulseHigh >= compressionHigh + atrRef * 0.6
longNearPol = math.abs(close - ema21) <= pullbackBand and low <= ema21 + atrRef * 0.15
longRejection = close > open and close >= ema9 - atrRef * 0.20
longPol = isLateral and longHadImpulse and longNearPol and longRejection

shortHadImpulse = impulseLow <= compressionLow - atrRef * 0.6
shortNearPol = math.abs(close - ema21) <= pullbackBand and high >= ema21 - atrRef * 0.15
shortRejection = close < open and close <= ema9 + atrRef * 0.20
shortPol = isLateral and shortHadImpulse and shortNearPol and shortRejection

stopMult = profile == "conservative" ? 0.7 : profile == "degen" ? 1.0 : 0.8
tpMult = profile == "conservative" ? 2.1 : profile == "degen" ? 3.0 : 2.4
volumeOk = volume > volumeSma * 1.05
longSignal = timeframeOk and bar_index >= 21 and ema9 > ema21 and macd > macdSignal and close > ema21 and rsi14 < 45 and stochK < 35 and volumeOk and longPol
shortSignal = timeframeOk and bar_index >= 21 and ema9 < ema21 and macd < macdSignal and close < ema21 and rsi14 > 55 and stochK > 65 and volumeOk and shortPol

longStop = close - atr14 * stopMult
longTarget = close + atr14 * tpMult
longStep = (longTarget - close) / 3.0
longTp1 = close + longStep
longTp2 = close + longStep * 2.0
longTp3 = longTarget

shortStop = close + atr14 * stopMult
shortTarget = close - atr14 * tpMult
shortStep = (close - shortTarget) / 3.0
shortTp1 = close - shortStep
shortTp2 = close - shortStep * 2.0
shortTp3 = shortTarget

plot(ema9, "EMA 9", color=color.new(color.aqua, 0), linewidth=1)
plot(ema21, "EMA 21", color=color.new(color.yellow, 0), linewidth=2)
plotshape(longSignal, title="HYBRID 15m LONG", style=shape.labelup, location=location.belowbar, color=color.new(color.lime, 0), text="H15 LONG", textcolor=color.black)
plotshape(shortSignal, title="HYBRID 15m SHORT", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), text="H15 SHORT", textcolor=color.white)

if longSignal
    label.new(bar_index, low, "HYBRID 15m LONG " + profile + "\nRSI " + str.tostring(rsi14, "#.0") + " | K " + str.tostring(stochK, "#.0") + "\nSL " + str.tostring(longStop, format.mintick) + " | TP3 " + str.tostring(longTp3, format.mintick), style=label.style_label_up, color=color.new(color.lime, 0), textcolor=color.black)
if shortSignal
    label.new(bar_index, high, "HYBRID 15m SHORT " + profile + "\nRSI " + str.tostring(rsi14, "#.0") + " | K " + str.tostring(stochK, "#.0") + "\nSL " + str.tostring(shortStop, format.mintick) + " | TP3 " + str.tostring(shortTp3, format.mintick), style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white)

alertcondition(longSignal, "HYBRID 15m LONG", "HYBRID 15m LONG {{ticker}} {{interval}}")
alertcondition(shortSignal, "HYBRID 15m SHORT", "HYBRID 15m SHORT {{ticker}} {{interval}}")


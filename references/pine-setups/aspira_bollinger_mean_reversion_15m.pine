//@version=5
indicator("Aspira Bollinger Mean Reversion 15m", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=500)

bbLen = input.int(20, "Bollinger length", minval=1)
bbStd = input.float(2.0, "Bollinger std", minval=0.1, step=0.1)
rsiLen = input.int(14, "RSI length", minval=1)
atrLen = input.int(14, "ATR length", minval=1)
volumeAvgLen = input.int(20, "Volume SMA length", minval=1)
volumeMultiplier = input.float(1.05, "Volume multiplier", minval=0.0, step=0.05)
atrBandMult = input.float(0.20, "ATR band displacement", minval=0.0, step=0.05)
stopPct = input.float(0.015, "Stop pct", minval=0.0, step=0.001)
takeProfitPct = input.float(0.02, "Max target pct", minval=0.0, step=0.001)
enforceTimeframe = input.bool(true, "Enforce 15m timeframe")

timeframeOk = not enforceTimeframe or timeframe.period == "15"
basis = ta.sma(close, bbLen)
dev = ta.stdev(close, bbLen) * bbStd
bbUpper = basis + dev
bbLower = basis - dev
rsi14 = ta.rsi(close, rsiLen)
atr14 = ta.atr(atrLen)
volumeSma = ta.sma(volume, volumeAvgLen)
volumeRatio = volumeSma > 0 ? volume / volumeSma : 0.0

qualityOk = atr14 > 0 and volumeRatio >= volumeMultiplier
longSignal = timeframeOk and bar_index >= bbLen and qualityOk and close <= bbLower - atrBandMult * atr14 and rsi14 < 35
shortSignal = timeframeOk and bar_index >= bbLen and qualityOk and close >= bbUpper + atrBandMult * atr14 and rsi14 > 72

longStop = close * (1.0 - stopPct)
longTarget = math.min(close * (1.0 + takeProfitPct), basis)
longStep = (longTarget - close) / 3.0
longTp1 = close + longStep
longTp2 = close + longStep * 2.0
longTp3 = longTarget

shortStop = close * (1.0 + stopPct)
shortTarget = math.max(close * (1.0 - takeProfitPct), basis)
shortStep = (close - shortTarget) / 3.0
shortTp1 = close - shortStep
shortTp2 = close - shortStep * 2.0
shortTp3 = shortTarget

plot(basis, "BB mid", color=color.new(color.aqua, 0), linewidth=2)
plot(bbUpper, "BB upper", color=color.new(color.orange, 0), linewidth=1)
plot(bbLower, "BB lower", color=color.new(color.orange, 0), linewidth=1)
plotshape(longSignal, title="Bollinger LONG", style=shape.labelup, location=location.belowbar, color=color.new(color.lime, 0), text="BB LONG", textcolor=color.black)
plotshape(shortSignal, title="Bollinger SHORT", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), text="BB SHORT", textcolor=color.white)

if longSignal
    label.new(bar_index, low, "Bollinger MR LONG\nRSI " + str.tostring(rsi14, "#.0") + " | Vol " + str.tostring(volumeRatio, "#.00") + "x\nSL " + str.tostring(longStop, format.mintick) + " | TP3 " + str.tostring(longTp3, format.mintick), style=label.style_label_up, color=color.new(color.lime, 0), textcolor=color.black)
if shortSignal
    label.new(bar_index, high, "Bollinger MR SHORT\nRSI " + str.tostring(rsi14, "#.0") + " | Vol " + str.tostring(volumeRatio, "#.00") + "x\nSL " + str.tostring(shortStop, format.mintick) + " | TP3 " + str.tostring(shortTp3, format.mintick), style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white)

alertcondition(longSignal, "Bollinger Mean Reversion 15m LONG", "Bollinger Mean Reversion 15m LONG {{ticker}} {{interval}}")
alertcondition(shortSignal, "Bollinger Mean Reversion 15m SHORT", "Bollinger Mean Reversion 15m SHORT {{ticker}} {{interval}}")


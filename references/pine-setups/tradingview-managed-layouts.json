  "contract": {
    "rule": "Cada setup/timeframe ativo deve apontar para um layout gerenciado do TradingView que já contém o Pine oficial do setup. O renderer não deve escolher layout aleatório nem usar o layout manual Intus.",
    "manual_layout_forbidden": {
      "name": "Intus",
      "chart_id": "<TRADINGVIEW_CHART_ID>"
    },
    "dynamic_trade_overlay": "Entrada, stop e alvos vêm do payload do trade e são desenhados temporariamente no print pela escala real do TradingView. Não fazem parte do Pine fixo.",
    "fail_closed": true
  },
  "defaults": {
    "profile_env": "SETUP_NOTIFY_TRADINGVIEW_PROFILE_DIR",
    "profile_default": "~/.openclaw/state/trade-automatizado-openclaw/tradingview-profile",
    "viewport": {
      "width": 2454,
      "height": 1280
    },
    "require_pine_in_layout": true,
    "allow_runtime_pine_insert": false,
    "close_sidebars_before_capture": true,
    "capture_mode": "wide_viewport"
  },

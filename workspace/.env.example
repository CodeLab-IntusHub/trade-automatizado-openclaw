# --- AMBIENTE ---
NETWORK=mainnet                  # fallback legado para NADO_NETWORK
EXCHANGES=nado,kraken            # opportunistic: aceita qualquer exchange CCXT; nado e DEX nao entram como fonte CCXT

# --- VENUES DEX/CEX CONFIGURAVEIS ---
DEX_ID=nado                       # nado | hyperliquid | id custom, ex.: dydx, uniswap
DEX_MARKET_TYPE=trade             # fallback amigavel para DEX CCXT/perps; Hyperliquid normaliza para swap, Nado ignora
CEX_ID=kraken                     # kraken ou qualquer exchange_id do CCXT, ex.: binance, bybit, okx, kucoin, mexc, bitget, gateio
# Para CEX nao-Kraken, use credenciais genericas ou especificas por exchange.
CEX_API_KEY=
CEX_API_SECRET=
CEX_API_PASSWORD=                 # exigido por algumas CEXs, como OKX/KuCoin
CEX_MARKET_TYPE=trade             # valor amigavel para perps/long-short; normaliza para CCXT swap. Use future/spot se exigido
# CEX_SANDBOX=false               # descomentado aqui, VENCE o settings.json e o deixa inoperante.
#                                 # Prefira venues.cex.sandbox no settings. Sem nada definido:
#                                 # Kraken nasce em sandbox, as demais CEXs em producao.
CEX_OPTIONS_JSON=                 # JSON opcional para options CCXT, ex.: {"defaultSubType":"linear"}
# Exemplos de envs especificas aceitas automaticamente:
# BINANCE_API_KEY/BINANCE_API_SECRET, BYBIT_API_KEY/BYBIT_API_SECRET,
# OKX_API_KEY/OKX_API_SECRET/OKX_API_PASSWORD, KUCOIN_API_KEY/KUCOIN_API_SECRET/KUCOIN_API_PASSWORD,
# MEXC_API_KEY/MEXC_API_SECRET, BITGET_API_KEY/BITGET_API_SECRET/BITGET_API_PASSWORD,
# GATEIO_API_KEY/GATEIO_API_SECRET.
# Para DEX customizada diferente de Nado/Hyperliquid, informe uma classe Python com a interface de trading da skill.
DEX_ADAPTER_MODULE=               # formato pacote.modulo:Classe, ex.: minha_dex.adapter:Trader
DEX_CONFIG_JSON=                  # objeto JSON opcional passado ao adapter, sem secrets no Git
DEX_NETWORK=                      # mainnet/testnet/devnet conforme adapter

# --- HYPERLIQUID (DEX builtin via CCXT) ---
HYPERLIQUID_WALLET_ADDRESS=       # endereco da wallet/conta Hyperliquid
HYPERLIQUID_PRIVATE_KEY=          # chave da API wallet/agent wallet; nunca commitar
HYPERLIQUID_VAULT_ADDRESS=        # opcional; use apenas se o usuario escolher operar via vault
HYPERLIQUID_NETWORK=mainnet       # mainnet | testnet
# HYPERLIQUID_SANDBOX=false       # descomentado, vence HYPERLIQUID_NETWORK e o settings.
#                                 # O adapter deriva a rede do sandbox, entao com
#                                 # NETWORK=testnet e SANDBOX=false voce opera na mainnet.
#                                 # Sem valor, a rede acima decide; o boot avisa se houver conflito.
HYPERLIQUID_MARKET_TYPE=trade     # valor amigavel; a skill normaliza para CCXT defaultType=swap/perps long-short
HYPERLIQUID_SYMBOL_QUOTE=USDT     # simbolo comum exibido pelo motor; Hyperliquid usa USDC nativo internamente
HYPERLIQUID_OPTIONS_JSON=         # JSON opcional de options CCXT, sem secrets

# --- NADO (Ink L2) ---
NADO_OWNER_PRIVATE_KEY=           # chave da wallet/conta operacional da Nado
NADO_PRIVATE_KEY=                 # alias legado; prefira NADO_OWNER_PRIVATE_KEY
PRIVATE_KEY=                      # alias generico legado opcional
NADO_LINKED_SIGNER_PRIVATE_KEY=   # chave dedicada do linked signer, opcional/recomendada
NADO_NETWORK=testnet              # testnet | mainnet
NADO_SUBACCOUNT_NAME=default_1    # opcional; ajuste so se usar nome customizado/doctor exigir
NADO_REQUIRE_LINKED_SIGNER=true   # valida linked signer quando configurado; se ausente, usa owner
NADO_FEE_TIER=entry               # entry | mid | elite
NADO_ALLOW_OWNER_FALLBACK=false   # true+confirmacao so para fallback por erro/mismatch; ausencia de linked signer ja usa owner

# --- KRAKEN ---
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_VENUE=futures              # futures | spot
# KRAKEN_SANDBOX=true             # true = demo.futures.kraken.com. Descomentado, vence o settings.
#                                 # Sem valor, a familia kraken ja nasce em sandbox.
KRAKEN_ACCOUNT=flex               # flex | cash | margin | <market symbol ex: BTC/USD:USD>
# obrigatorio so quando KRAKEN_ACCOUNT=margin
KRAKEN_ACCOUNT_SYMBOL=
KRAKEN_REQUIRE_SUBACCOUNT=false   # default; true somente se o usuario escolher validacao estrita de subconta
KRAKEN_API_IS_SUBACCOUNT=false    # true so quando a API key realmente for de subconta
KRAKEN_ALLOW_MAIN_ACCOUNT=false   # so use true com DELTA_NEUTRAL_CONFIRM_PRIVILEGED_FALLBACK=true

# --- CONFIRMACOES DE EXECUCAO ---
AUTORIZAR_TRADE_REAL=nao              # defina sim somente na execucao real aprovada
CONFIRMAR_TRADE_REAL=nao              # alias em portugues tambem aceito
TRADE_AUTOMATIZADO_CONFIRM_LIVE=false  # alias tecnico: defina true somente na execucao live aprovada
DELTA_NEUTRAL_CONFIRM_LIVE=false       # alias legado aceito; prefira AUTORIZAR_TRADE_REAL
DELTA_NEUTRAL_CONFIRM_PRIVILEGED_FALLBACK=false  # confirma fallback owner/main account quando solicitado

# --- DELTA-NEUTRAL ---
VOLUME_ORDER=100                  # notional USD por perna
ORDER_TYPE=market                 # usado por scripts auxiliares Nado
DRIFT_BPS=50                      # rebalance se delta > 0,50% do notional
MAX_PAIR_LOSS_PCT=0.03            # stop global do par (3% do notional total)
SLIPPAGE_BPS=100                  # 100 = 1% de slippage em ordens market
PROTECTIVE_STOP_LOSS_PCT=0.03     # stop loss reduce-only por perna aberta pelo bot
PROTECTIVE_TAKE_PROFIT_PCT=0.03   # take profit reduce-only por perna aberta pelo bot
PROTECTIVE_STOP_TRIGGER_SLIPPAGE_PCT=0.01  # slippage da ordem disparada pelo trigger

# --- MODO DE EXECUCAO / MARGEM ---
EXECUTION_MODE=hedged             # hedged | dex_only/nado_only | cex_only/kraken_only
MARGIN_MODE=cross                 # cross | isolated
NADO_MARGIN_MODE=isolated         # margem DEX/Nado; vazio usa MARGIN_MODE
KRAKEN_MARGIN_MODE=cross          # margem CEX/Kraken; vazio usa MARGIN_MODE
MARGIN_USD=                       # opcional: notional operacional = margem * leverage
NADO_MARGIN_USD=                  # override DEX/Nado; tambem aceita DEX_MARGIN_USD
DEX_MARGIN_USD=                   # alias generico para margem da DEX selecionada
KRAKEN_MARGIN_USD=                # override CEX/Kraken; tambem aceita CEX_MARGIN_USD
CEX_MARGIN_USD=                   # alias generico para margem da CEX selecionada
LEVERAGE=                         # leverage padrao opcional
NADO_LEVERAGE=                    # override DEX/Nado opcional
DEX_LEVERAGE=                     # alias generico para leverage da DEX selecionada
KRAKEN_LEVERAGE=                  # override CEX/Kraken opcional
CEX_LEVERAGE=                     # alias generico para leverage da CEX selecionada

# --- SETUPS / CALIBRACAO ---
# Calibracao de setup agora vive em settings.json, sob `setups.<chave>`.
# Ver settings.example.json e Docs/features/configuracao-de-setups.md.
#
# Estas vars continuam funcionando e tem PRECEDENCIA sobre o settings: se
# alguma estiver definida, o valor do settings para o mesmo campo e ignorado.
# Por isso vem comentadas -- descomente so o que quiser fixar por ambiente.
#
# TRIANGLE_PIVOT_WINDOW=2
# TRIANGLE_CONTRACTION_MAX_RATIO=0.80
# TRIANGLE_VOLUME_MULTIPLIER=2.0
# TRIANGLE_BREAKOUT_BUFFER_ATR_MULT=0.50
# TRIANGLE_FLAT_THRESHOLD_ATR_MULT=0.05
# TRIANGLE_SLOPE_THRESHOLD_ATR_MULT=0.02
# TRIANGLE_STOP_ATR_MULT=0.8
# FUNDING_ARB_MIN_RATE=0.00030
# FUNDING_ARB_EXIT_RATE=0.00002
# FUNDING_ARB_MAX_HOLD_HOURS=72
# FUNDING_ARB_MAX_SPREAD_BPS=20.0

# --- SETUP-LIVE GUARDRAILS ---
SETUP_ENTRY_MIN_NADO_BALANCE_RATIO=0.05
SETUP_ENTRY_MIN_KRAKEN_MARGIN_RATIO=0.20
SETUP_ENTRY_MIN_NADO_INITIAL_HEALTH=2.0
# Opcional/avancado: substitui o minimo de notional consultado da Nado para
# validacao local de entrada. Nao altera regras reais da venue; ordens abaixo
# do minimo efetivo da Nado ainda podem ser rejeitadas na execucao.
NADO_MIN_ORDER_NOTIONAL_USD=
# Limite global de setups live abertos. Use 1 para abrir uma operacao e parar
# novas entradas enquanto ela estiver gerenciada.
SETUP_LIVE_MAX_OPEN_SETUPS=1
# Politica de ajuste do stop quando alvos do setup sao atingidos:
# off/desligado = stop fixo; breakeven_on_tp1/entrada-no-tp1 = TP1 -> entrada; ladder/escada = TP1 -> entrada, TP2 -> TP1...
SETUP_LIVE_TARGET_STOP_MODE=off
# Blacklist temporaria de perps Nado ainda nao operacionais/saudaveis.
DEX_DISABLED_PERP_SYMBOLS=            # blacklist generica para a DEX selecionada
DEX_EXCLUDE_SYMBOLS=
NADO_DISABLED_PERP_SYMBOLS=ADA/USDT,ARB/USDT
NADO_EXCLUDE_SYMBOLS=
# DIVERGENCE_AND_VOLUME entra apenas nos simbolos validados por padrao. Use open/off apenas
# para pesquisa monitorada, nao para execucao live sem nova validacao operacional.
DIVERGENCE_AND_VOLUME_WHITELIST_MODE=strict
DIVERGENCE_AND_VOLUME_ALLOWED_SYMBOLS=ETH/USDT,XMR/USDT
# Guardrail cross/account da Nado para setup-live. Se SETUP_ACCOUNT_MARGIN_SLOTS > 0
# e --margin-usd nao for informado, margem por entrada = orcamento operacional / slots.
SETUP_ACCOUNT_MARGIN_RESERVE_USD=
SETUP_ACCOUNT_MARGIN_RESERVE_PCT=20
SETUP_ACCOUNT_MARGIN_SLOTS=8
SETUP_ACCOUNT_MAX_MAINT_USAGE_PCT=80
SETUP_ACCOUNT_STRESS_PCT=10
# Notificacao de entrada confirmada. O destino principal pode ser Telegram,
# WhatsApp ou outro canal aceito pelo OpenClaw.
# Para entregar tambem no Discord, preencha SETUP_NOTIFY_ENTRY_DISCORD_CHANNEL_ID.
SETUP_NOTIFY_ENTRY_ENABLED=true
# Telegram: SETUP_NOTIFY_ENTRY_CHANNEL=telegram e target=<chat_id_ou_usuario>.
# WhatsApp: SETUP_NOTIFY_ENTRY_CHANNEL=whatsapp e target=<chat_id_ou_destino_whatsapp>.
# Em setup-live --dry-run, oportunidades usam o mesmo canal; com
# SETUP_NOTIFY_TRADINGVIEW_IMAGE=true, WhatsApp/Discord recebem texto + PNG.
SETUP_NOTIFY_ENTRY_CHANNEL=telegram
SETUP_NOTIFY_ENTRY_TARGET=
SETUP_NOTIFY_ENTRY_ACCOUNT=
# Token do bot Discord; salvar no Secret Manager/env seguro, nunca no Git.
DISCORD_BOT_TOKEN=
SETUP_NOTIFY_ENTRY_DISCORD_CHANNEL_ID=
SETUP_NOTIFY_ENTRY_DISCORD_ACCOUNT=
SETUP_NOTIFY_BRAND=ASPIRA TRADE
SETUP_NOTIFY_TIMEZONE=America/Sao_Paulo
# Aspira entrega Discord como texto + imagem na mesma mensagem; sem card/embed.
SETUP_NOTIFY_DISCORD_NATIVE_EMBED=false
SETUP_NOTIFY_DISCORD_EMBED_AUTHOR=ASPIRA TRADE
SETUP_NOTIFY_DISCORD_BOX=false
SETUP_NOTIFY_DISCORD_BOX_STYLE=code
# Opcional: use mencao de cargo real como <@&DISCORD_ROLE_ID>.
SETUP_NOTIFY_DISCORD_MENTION=

# --- DECISION ENGINE (opportunistic) ---
CERTAINTY=70                      # aceita 70, 70% ou 0.70
MAX_PERCENT_LOSS=1%
MAX_PERCENT_PROFIT=2%
UNIQUE_TREND=                     # vazio, LONG ou SHORT; booleanos sao ignorados
MAX_TRADES_PER_RUN=1
MAX_OPPORTUNITIES=5

# --- AUTOMACOES OPCIONAIS NADO ---
AUTO_DEPOSIT_ENABLED=false
AUTO_DEPOSIT_MIN_BALANCE=0
AUTO_DEPOSIT_AMOUNT=0
AUTO_WITHDRAW_ENABLED=false
AUTO_WITHDRAW_MIN_BALANCE=0
AUTO_WITHDRAW_LEAVE_ON_NADO=0
